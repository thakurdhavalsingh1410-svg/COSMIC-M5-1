class CosmicWebServer:
    def __init__(
        self,
        submit_message: Callable[[str], bool],
        get_status: Callable[[], dict],
        get_logs: Callable[[int], dict],
        set_muted: Callable[[bool], bool] | None = None,
        set_autonomy: Callable[[str], bool] | None = None,
        set_performance: Callable[[str], bool] | None = None,
        host: str = WEB_HOST,
        port: int = WEB_PORT,
    ):
        self.submit_message = submit_message
        self.get_status = get_status
        self.get_logs = get_logs
        self.set_muted = set_muted
        self.set_autonomy = set_autonomy
        self.set_performance = set_performance
        self.host = host
        self.port = port
        self._server: ThreadingHTTPServer | None = None


    def _authorized(self, handler) -> bool:
        config = _load_phone_security()
        if not config.get("enabled", False):
            return True
        return _verify_phone_pin(handler.headers.get("X-COSMIC-PIN", ""), config)

    def security_status(self, client_address: str = "") -> dict:
        config = _load_phone_security()
        pin_enabled = bool(config.get("enabled", False))
        return {
            "pin_enabled": pin_enabled,
            "pin_required": pin_enabled,
            "strict_web_pin": pin_enabled,
        }

    def access_urls(self) -> dict:
        local = [f"http://localhost:{self.port}"]
        network: list[str] = []
        tailscale: list[str] = []
        if self.host not in {"127.0.0.1", "::1", "localhost"}:
            for ip in _ip_candidates():
                url = f"http://{ip}:{self.port}"
                if ip.startswith("100."):
                    tailscale.append(url)
                else:
                    network.append(url)
        return {
            "local": local,
            "network": network,
            "tailscale": tailscale,
            "host": self.host,
            "port": self.port,
        }

    def start(self) -> str:
        owner = self

        class Handler(BaseHTTPRequestHandler):
            def _send_bytes(
                self,
                body: bytes,
                content_type: str,
                cache_control: str = "no-store",
                csp: str | None = None,
            ):
                self.send_response(200)
                self.send_header("Content-Type", content_type)
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", cache_control)
                self.send_header("X-Content-Type-Options", "nosniff")
                if csp:
                    self.send_header("Content-Security-Policy", csp)
                self.end_headers()
                self.wfile.write(body)

            def _try_static(self, request_path: str) -> bool:
                if not DIST_DIR.exists():
                    return False

                try:
                    dist_root = DIST_DIR.resolve()
                    relative = request_path.lstrip("/") or "index.html"
                    static_path = (dist_root / relative).resolve()
                    static_path.relative_to(dist_root)

                    if static_path.is_dir():
                        static_path = static_path / "index.html"
                    if not static_path.is_file():
                        return False

                    content_type = (
                        mimetypes.guess_type(static_path.name)[0]
                        or "application/octet-stream"
                    )
                    cache_control = "public, max-age=31536000, immutable"
                    if static_path.name == "index.html":
                        content_type = "text/html; charset=utf-8"
                        cache_control = "no-store"

                    self._send_bytes(
                        static_path.read_bytes(),
                        content_type,
                        cache_control,
                        "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:",
                    )
                    return True
                except (OSError, ValueError):
                    return False

            def _json(self, payload: dict, status: int = 200):
                body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
                self.send_response(status)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", "no-store")
                self.send_header("X-Content-Type-Options", "nosniff")
                self.end_headers()
                self.wfile.write(body)

            def do_GET(self):
                parsed = urlparse(self.path)
                if parsed.path == "/":
                    if USE_DIST_WEB and self._try_static("index.html"):
                        return
                    self._send_bytes(
                        WEB_PAGE.replace("__COSMIC_BUILD_TOKEN__", BUILD_TOKEN).encode("utf-8"),
                        "text/html; charset=utf-8",
                        "no-store",
                        "default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'",
                    )
                    return
                if parsed.path == "/manifest.webmanifest":
                    self._send_bytes(
                        json.dumps(_manifest(), ensure_ascii=False).encode("utf-8"),
                        "application/manifest+json; charset=utf-8",
                        "no-store",
                    )
                    return
                if parsed.path == "/sw.js":
                    self._send_bytes(
                        SERVICE_WORKER.replace("__COSMIC_BUILD_TOKEN__", BUILD_TOKEN).encode("utf-8"),
                        "application/javascript; charset=utf-8",
                        "no-store",
                        "default-src 'self'; script-src 'self'",
                    )
                    return
                if parsed.path == "/favicon.ico":
                    icon_path = PROJECT_ROOT / "assets" / "cosmic.ico"
                    if icon_path.is_file():
                        self._send_bytes(icon_path.read_bytes(), "image/x-icon", "public, max-age=86400")
                        return
                if parsed.path == "/assets/cosmic_icon.png":
                    icon_path = PROJECT_ROOT / "assets" / "cosmic_icon.png"
                    if icon_path.is_file():
                        self._send_bytes(icon_path.read_bytes(), "image/png", "public, max-age=86400")
                        return
                if parsed.path == "/api/security":
                    self._json(owner.security_status(self.client_address[0] if self.client_address else ""))
                    return
                if parsed.path in {"/api/research_tasks", "/api/status", "/api/access", "/api/logs", "/api/calendar", "/api/calendar.ics", "/api/voice", "/api/goals"}:
                    if not owner._authorized(self):
                        self._json({"error": "PIN required for remote phone access", "requires_pin": True}, 401)
                        return
                if parsed.path == "/api/calendar":
                    self._json(_calendar_snapshot())
                    return
                if parsed.path == "/api/goals":
                    self._json(_active_goals_snapshot())
                    return
                if parsed.path == "/api/voice":
                    self._json({"voice": _load_voice_config_web(), "voices": []})
                    return
                if parsed.path == "/api/calendar.ics":
                    ics = _write_calendar_export()
                    self._send_bytes(
                        ics.encode("utf-8"),
                        "text/calendar; charset=utf-8",
                        "no-store",
                    )
                    return
                if parsed.path == "/api/research_tasks":
                    self._json(_research_task_snapshot())
                    return
                if parsed.path == "/api/status":
                    self._json(owner.get_status())
                    return
                if parsed.path == "/api/access":
                    self._json(owner.access_urls())
                    return
                if parsed.path == "/api/logs":
                    try:
                        after = max(0, int(parse_qs(parsed.query).get("after", [0])[0]))
                    except (TypeError, ValueError):
                        after = 0
                    self._json(owner.get_logs(after))
                    return
                if USE_DIST_WEB and parsed.path.startswith("/assets/") and self._try_static(parsed.path):
                    return
                self._json({"error": "Not found"}, 404)

            def do_POST(self):
                path = urlparse(self.path).path
                if path not in {"/api/message", "/api/mute", "/api/auth", "/api/autonomy", "/api/performance", "/api/calendar", "/api/voice", "/api/goals"}:
                    self._json({"error": "Not found"}, 404)
                    return
                origin = self.headers.get("Origin")
                if origin and urlparse(origin).netloc != self.headers.get("Host"):
                    self._json({"error": "Cross-origin requests are not allowed"}, 403)
                    return
                if not owner._authorized(self):
                    self._json({"error": "PIN required for remote phone access", "requires_pin": True}, 401)
                    return
                try:
                    length = int(self.headers.get("Content-Length", "0"))
                    if length <= 0 or length > 262144:
                        raise ValueError("Invalid request size")
                    payload = json.loads(self.rfile.read(length).decode("utf-8"))
                    if path == "/api/auth":
                        self._json({"accepted": True}, 202)
                        return
                    if path == "/api/goals":
                        action = str(payload.get("action") or "save").strip().lower()
                        if action in {"save", "update", "set"}:
                            goals = _save_active_goals(payload.get("goals") if isinstance(payload.get("goals"), dict) else payload)
                            self._json({"accepted": True, "goals": goals}, 202)
                            return
                        if action == "reset":
                            goals = _save_active_goals(_default_active_goals())
                            self._json({"accepted": True, "goals": goals}, 202)
                            return
                        self._json({"error": "Unknown goals action"}, 400)
                        return
                    if path == "/api/calendar":
                        action = str(payload.get("action") or "upsert").strip().lower()
                        if action == "upsert":
                            event = _upsert_calendar_event(payload.get("event", {}))
                            snapshot = _calendar_snapshot()
                            snapshot.update({"accepted": True, "event": event})
                            self._json(snapshot, 202)
                            return
                        if action == "delete":
                            deleted = _delete_calendar_event(str(payload.get("id", "")))
                            snapshot = _calendar_snapshot()
                            snapshot.update({"accepted": deleted, "deleted": deleted})
                            self._json(snapshot, 202 if deleted else 404)
                            return
                        if action == "import_ics":
                            imported = _import_ics_calendar(str(payload.get("ics", "")))
                            snapshot = _calendar_snapshot()
                            snapshot.update({"accepted": True, "imported": imported})
                            self._json(snapshot, 202)
                            return
                        self._json({"error": "Unknown calendar action"}, 400)
                        return
                    if path == "/api/voice":
                        action = str(payload.get("action") or "update").strip().lower()
                        if action in {"update", "set"}:
                            voice = _save_voice_config_web(payload.get("voice") if isinstance(payload.get("voice"), dict) else payload)
                            self._json({"accepted": True, "voice": voice}, 202)
                            return
                        if action in {"test", "speak"}:
                            voice_payload = payload.get("voice") if isinstance(payload.get("voice"), dict) else payload
                            voice = _save_voice_config_web(voice_payload)
                            message = _test_voice_web(str(payload.get("text") or ""))
                            self._json({"accepted": not message.startswith("Voice test failed"), "voice": voice, "message": message}, 202)
                            return
                        if action in {"list", "voices"}:
                            self._json({"accepted": True, "voice": _load_voice_config_web(), "voices": _list_windows_voices_web()}, 202)
                            return
                        self._json({"error": "Unknown voice action"}, 400)
                        return
                    if path == "/api/performance":
                        if owner.set_performance is None:
                            self._json({"error": "Performance control is not available"}, 503)
                            return
                        mode = str(payload.get("mode", "")).strip().lower()
                        if mode not in {"cinematic", "balanced", "performance"}:
                            self._json({"error": "Performance mode must be cinematic, balanced, or performance"}, 400)
                            return
                        if not owner.set_performance(mode):
                            self._json({"error": "Performance control failed"}, 503)
                            return
                        self._json({"accepted": True, "mode": mode}, 202)
                        return
                    if path == "/api/autonomy":
                        if owner.set_autonomy is None:
                            self._json({"error": "Autonomy control is not available"}, 503)
                            return
                        level = str(payload.get("level", "")).strip().lower()
                        if level not in {"low", "balanced", "high"}:
                            self._json({"error": "Autonomy level must be low, balanced, or high"}, 400)
                            return
                        if not owner.set_autonomy(level):
                            self._json({"error": "Autonomy control failed"}, 503)
                            return
                        self._json({"accepted": True, "level": level}, 202)
                        return
                    if path == "/api/mute":
                        if owner.set_muted is None:
                            self._json({"error": "Mute control is not available"}, 503)
                            return
                        muted = bool(payload.get("muted"))
                        if not owner.set_muted(muted):
                            self._json({"error": "Mute control failed"}, 503)
                            return
                        self._json({"accepted": True, "muted": muted}, 202)
                        return
                    text = str(payload.get("text", "")).strip()
                    if not text:
                        raise ValueError("Message is empty")
                    if len(text) > 4000:
                        raise ValueError("Message is too long")
                    if not owner.submit_message(text):
                        self._json({"error": "COSMIC is still connecting"}, 503)
                        return
                    self._json({"accepted": True}, 202)
                except (ValueError, json.JSONDecodeError) as exc:
                    self._json({"error": str(exc)}, 400)

            def log_message(self, *_):
                return

        self._server = ThreadingHTTPServer((self.host, self.port), Handler)
        self.port = self._server.server_address[1]
        threading.Thread(
            target=self._server.serve_forever,
            daemon=True,
            name="CosmicWebServer",
        ).start()
        display_host = "localhost" if self.host in {"127.0.0.1", "::1", "0.0.0.0", ""} else self.host
        return f"http://{display_host}:{self.port}"

    def stop(self) -> None:
        if self._server:
            self._server.shutdown()
            self._server.server_close()
            self._server = None

