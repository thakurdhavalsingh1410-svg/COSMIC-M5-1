<script>
  const $=s=>document.querySelector(s), workspace=$('#workspace'), statusEl=$('#status'), form=$('#form'), input=$('#message'), button=$('#sendButton'), muteBtn=$('#muteToggle'), quickPanel=$('#quickPanel');
  let cursor=0,activeTab='Home',webMuted=false,deferredInstall=null,unlocked=false,polling=false,lastMetrics={},lastAutonomy={level:'balanced'},lastBackgroundTasks=[],lastResearchTasks=[],lastPerformance={mode:'performance',web_poll_ms:3000},lastVoice={engine:'windows',gemini_voice:'Charon',windows_voice:'',windows_rate:0,windows_volume:90},uiLogs=['SYS: COSMIC command dialogue ready.'];
  window.addEventListener('beforeinstallprompt', e=>{e.preventDefault();deferredInstall=e;});


  // COSMIC_FIX_RESTORE_WEB_HELPERS
  function escapeHtml(value){
    return String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
  }
  function stars(){
    const starLayer=$('#stars'), particleLayer=$('#particles');
    if(starLayer && !starLayer.children.length){
      for(let i=0;i<72;i++){
        const s=document.createElement('i');
        s.className='star';
        s.style.left=(Math.random()*100).toFixed(2)+'%';
        s.style.top=(Math.random()*100).toFixed(2)+'%';
        s.style.animationDelay=(Math.random()*3).toFixed(2)+'s';
        starLayer.appendChild(s);
      }
    }
    if(particleLayer && !particleLayer.children.length){
      for(let i=0;i<18;i++){
        const p=document.createElement('i');
        p.className='particle';
        p.style.left=(Math.random()*100).toFixed(2)+'%';
        p.style.top=(Math.random()*100).toFixed(2)+'%';
        p.style.animationDelay=(-(Math.random()*18)).toFixed(2)+'s';
        particleLayer.appendChild(p);
      }
    }
  }
  function clock(){
    const el=$('#clock');
    if(!el)return;
    el.textContent=new Date().toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
  }
  function makeWave(count=48){
    return Array.from({length:count},(_,i)=>'<i style="height:'+(6+Math.abs(Math.sin(i*.44))*22).toFixed(0)+'px;animation-delay:'+(i*.035).toFixed(2)+'s"></i>').join('');
  }
  function logsHtml(){
    return uiLogs.slice(-18).map(line => '<div class="bubble ai">'+escapeHtml(line)+'</div>').join('');
  }
  function add(line){
    line=String(line || '').trim();
    if(!line)return;
    uiLogs.push(line);
    if(uiLogs.length>80)uiLogs=uiLogs.slice(-80);
    const box=$('#dialogueLog');
    if(box){
      const div=document.createElement('div');
      div.className=line.startsWith('Dhaval:')?'bubble user':'bubble ai';
      div.textContent=line;
      box.appendChild(div);
      box.scrollTop=box.scrollHeight;
    }
  }
  function updateMuteButton(){
    if(muteBtn)muteBtn.textContent=webMuted?'Unmute':'Mute';
  }
  function pct(value,fallback=0){
    const n=Number(value);
    return Number.isFinite(n)?Math.max(0,Math.min(100,n)):fallback;
  }
  function healthColor(label,health){
    if(String(label||'').toLowerCase().includes('high') || health<60)return 'var(--red)';
    if(String(label||'').toLowerCase().includes('busy') || health<82)return 'var(--yellow)';
    return 'var(--green)';
  }
  function miniWave(){
    const a=Array.from({length:42},(_,i)=>`${i*6},${36+(Math.sin(i*.7)*12)+(Math.cos(i*.23)*7)}`).join(' ');
    const b=Array.from({length:42},(_,i)=>`${i*6},${38+(Math.cos(i*.55)*10)}`).join(' ');
    return '<div class="miniWave"><svg viewBox="0 0 246 74" preserveAspectRatio="none"><polyline points="'+a+'" fill="none" stroke="#67e8f9" stroke-width="2"/><polyline points="'+b+'" fill="none" stroke="#a855f7" stroke-width="2" opacity=".85"/></svg></div>';
  }
  function systemCards(){
    const m=lastMetrics||{};
    const health=pct(m.health ?? 100,100);
    const label=m.health_label || (health>82?'Optimal':health>60?'Busy':'High load');
    const color=healthColor(label,health);
    document.documentElement.style.setProperty('--health', health);
    document.documentElement.style.setProperty('--healthColor', color);
    return '<div class="systemGrid"><div class="card"><h2>SYSTEM STATUS</h2><div class="statusRing"><div><b id="healthValue">'+Math.round(health)+'%</b><span id="healthLabel">'+escapeHtml(label).toUpperCase()+'</span></div></div><div class="component"><span>Core Systems</span><strong>Online</strong></div><div class="component"><span>Memory Bank</span><strong>Stable</strong></div><div class="component"><span>Knowledge Graph</span><strong>Active</strong></div><div class="component"><span>Learning Engine</span><strong>Active</strong></div></div><div class="card"><h2>UPTIME / SYSTEM HEALTH</h2>'+miniWave()+'<div class="healthGrid"><div><span>CPU</span><b id="metricCpu">'+Math.round(pct(m.cpu))+'%</b></div><div><span>Memory</span><b id="metricMemory">'+Math.round(pct(m.memory))+'%</b></div><div><span>Network</span><b id="metricNet">'+Number(m.network_mbps||0).toFixed(2)+' MB/s</b></div></div><div class="metric"><span>Processes</span><strong id="metricProcesses">'+escapeHtml(m.processes ?? '-').toString()+'</strong></div><div class="metric"><span>Uptime</span><strong id="metricUptime">'+formatUptime(m.uptime_seconds)+'</strong></div></div></div>'+autonomyCard();
  }
  function formatUptime(seconds){
    seconds=Math.max(0,Number(seconds)||0);
    const h=Math.floor(seconds/3600), m=Math.floor((seconds%3600)/60), s=Math.floor(seconds%60);
    return String(h).padStart(2,'0')+':'+String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
  }
  function updateMetrics(metrics){
    lastMetrics=Object.assign({},lastMetrics||{},metrics||{});
    const m=lastMetrics, health=pct(m.health ?? 100,100), label=m.health_label || (health>82?'Optimal':health>60?'Busy':'High load'), color=healthColor(label,health);
    document.documentElement.style.setProperty('--health', health);
    document.documentElement.style.setProperty('--healthColor', color);
    const set=(id,value)=>{const el=document.getElementById(id);if(el)el.textContent=value};
    set('healthValue',Math.round(health)+'%');set('healthLabel',String(label).toUpperCase());
    set('metricCpu',Math.round(pct(m.cpu))+'%');set('metricMemory',Math.round(pct(m.memory))+'%');
    set('metricNet',Number(m.network_mbps||0).toFixed(2)+' MB/s');set('metricProcesses',m.processes ?? '-');
    set('metricUptime',formatUptime(m.uptime_seconds));
    set('hubHealth',Math.round(health)+'%');set('hubHealthLabel',String(label).toUpperCase());
    set('hubCpu',Math.round(pct(m.cpu))+'%');set('hubCpu2',Math.round(pct(m.cpu))+'%');
    set('hubMem',Math.round(pct(m.memory))+'%');set('hubMem2',Math.round(pct(m.memory))+'%');
    set('hubNet2',Number(m.network_mbps||0).toFixed(2));
  }
  function autonomyCard(){
    const level=(lastAutonomy&&lastAutonomy.level)||'balanced';
    return '<div class="card"><h2>AUTONOMY / RESEARCH</h2><div class="project">Thinking mode <span id="autonomyMode" style="float:right;color:var(--cyan2)">'+escapeHtml(level).toUpperCase()+'</span></div><div class="subgrid" style="grid-template-columns:repeat(3,1fr);margin-top:12px"><button type="button" data-autonomy="low" class="pill">Low</button><button type="button" data-autonomy="balanced" class="pill">Balanced</button><button type="button" data-autonomy="high" class="pill">High</button></div><div class="objectives" id="backgroundTaskList" style="margin-top:14px"><div class="objective">Background task layer ready</div><div class="objective">Research notes can be promoted into memory</div></div></div>';
  }
  function updateAutonomyView(){
    const level=(lastAutonomy&&lastAutonomy.level)||'balanced';
    const mode=$('#autonomyMode');if(mode)mode.textContent=level.toUpperCase();
    document.querySelectorAll('[data-autonomy]').forEach(b=>b.classList.toggle('active',b.dataset.autonomy===level));
    const list=$('#backgroundTaskList');
    if(list){
      const items=[...(lastBackgroundTasks||[]),...(lastResearchTasks||[])].slice(-4);
      list.innerHTML=(items.length?items.map(x=>'<div class="objective">'+escapeHtml(x.title||x.query||x.status||JSON.stringify(x))+'</div>').join(''):'<div class="objective">No active background tasks</div>');
