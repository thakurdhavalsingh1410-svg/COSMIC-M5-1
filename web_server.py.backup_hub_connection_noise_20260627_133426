<body>
<div id="pinLock" class="pinLock hidden" aria-modal="true" role="dialog"><div class="pinBox"><h2>COSMIC LOCKED</h2><p>Enter your COSMIC phone PIN to unlock the command center.</p><input id="pinInput" inputmode="numeric" autocomplete="one-time-code" maxlength="12" placeholder="PIN"><button id="pinUnlock" type="button">Unlock COSMIC</button><div id="pinError" class="pinError"></div></div></div>
<div class="stars" id="stars"></div><div class="particles" id="particles"></div>
<div class="app">
  <aside class="dock"><div class="brand">COSMIC</div><nav class="nav" id="nav"><button class="active" data-panel="Home"><b>⌂</b>Home</button><button data-panel="Memory"><b>◌</b>Memory</button><button data-panel="Research"><b>◇</b>Research</button><button data-panel="Tasks"><b>☑</b>Tasks</button><button data-panel="Calendar"><b>▣</b>Calendar</button><button data-panel="System"><b>⬡</b>System</button></nav><div class="dockTools"><span>✦</span><span>≋</span><span>☆</span><span>⚙</span><span>＋</span><span>－</span></div></aside>
  <main>
    <header class="top"><div class="localMark">LOCAL AI</div><div class="titleWrap"><div class="title">COSMIC</div><div class="subtitle">Your Personal AI Command System</div></div><div class="utils"><div><div class="clock" id="clock">--:-- PM</div><div class="status" id="status">CONNECTING</div></div><button class="utilBtn" id="quickInstall" type="button" title="Install or open app">⌁</button><button class="utilBtn" id="quickBell" type="button" title="Notifications">🔔</button><button class="utilBtn" id="quickVoice" type="button" title="Voice settings">🎙</button><button class="utilBtn" id="quickSettings" type="button" title="System settings">⚙</button><button class="utilBtn profile" id="quickProfile" type="button" title="COSMIC status">◉</button></div></header>
    <section class="workspace home" id="workspace"></section>
    <section class="actions"><button class="action" data-action="Study Mode"><span class="badge">Predictive</span><span class="actionIcon">□</span><b>Study Mode</b><span>Focus and learn deeply</span><span class="arrow">→</span></button><button class="action" data-action="Brainstorm"><span class="badge">Predictive</span><span class="actionIcon">◌</span><b>Brainstorm</b><span>Generate clean ideas</span><span class="arrow">→</span></button><button class="action purple" data-action="Voice Command"><span class="badge">Predictive</span><span class="actionIcon">🎙</span><b>Voice Command</b><span>Speak or type naturally</span><span class="arrow">→</span></button><button class="action" data-action="Tasks"><span class="badge">Predictive</span><span class="actionIcon">☑</span><b>Tasks</b><span>Track and complete work</span><span class="arrow">→</span></button><button class="action" data-action="System Control"><span class="badge">Predictive</span><span class="actionIcon">⬡</span><b>System Control</b><span>Settings and controls</span><span class="arrow">→</span></button></section>
    <form id="form"><input id="message" maxlength="4000" autocomplete="off" placeholder="Initiate Physics deep-dive or ask for project details..."><button id="muteToggle" type="button">Mute</button><button id="sendButton" type="submit">➤</button></form>
  </main>
