def _clamp_int(value: object, low: int, high: int, fallback: int) -> int:
    try:
        number = int(value)
    except (TypeError, ValueError):
        number = fallback
    return max(low, min(high, number))


def _clean_voice_config(data: dict | None = None) -> dict:
    config = dict(VOICE_DEFAULTS)
    if isinstance(data, dict):
        config.update(data)
    engine = str(config.get("engine", "windows")).lower().strip()
    config["engine"] = engine if engine in {"windows", "gemini", "hybrid"} else "windows"
    config["gemini_voice"] = str(config.get("gemini_voice") or "Charon").strip() or "Charon"
    config["windows_voice"] = str(config.get("windows_voice") or "").strip()
    config["windows_rate"] = _clamp_int(config.get("windows_rate"), -10, 10, 0)
    config["windows_volume"] = _clamp_int(config.get("windows_volume"), 0, 100, 90)
    config["windows_fallback"] = bool(config.get("windows_fallback", True))
    config["announce_system_messages"] = bool(config.get("announce_system_messages", False))
    return config


