    .goalActions .primary{background:linear-gradient(135deg,rgba(0,240,255,.26),rgba(168,85,247,.24));color:#eaffff}
    .goalHint{font-size:12px;color:var(--muted);margin-top:-4px}


    /* COSMIC_EXPANDED_CALENDAR_UI */
    body[data-tab="Calendar"] main{grid-template-rows:88px minmax(0,1fr) 0 62px}
    body[data-tab="Calendar"] .actions{display:none}
    body[data-tab="Calendar"] .workspace.calendar{min-height:0}
    .calendarShell{height:100%;min-height:0}
    .calendarCard,.calendarEditor{min-height:0}
    .calendarCard{display:flex;flex-direction:column}
    .calendarCard .calendarToolbar{flex:0 0 auto}
    .calendarCard .calendarWeek{flex:0 0 auto;margin-bottom:6px}
    .calendarCard .calendarGrid{flex:1;min-height:0;grid-template-rows:repeat(6,minmax(78px,1fr))}
    .calendarCard .calendarDay{min-height:0;padding:10px;border-radius:18px}
    .calendarCard .dayNum{font-size:16px}
    .calendarCard .eventDot{font-size:11px;padding:3px 7px;margin-top:6px}
    .calendarCard .calendarDay.selected{background:linear-gradient(145deg,rgba(0,240,255,.20),rgba(168,85,247,.16));border-color:rgba(103,232,249,.88);box-shadow:inset 0 0 24px rgba(0,240,255,.14),0 0 22px rgba(0,240,255,.20)}
    .calendarEditor{display:flex;flex-direction:column;overflow:auto}
    .calendarEditor .calendarForm textarea{height:118px}
    .calendarEditor .eventList{max-height:none;min-height:128px;flex:1}
    .calendarEditor .icsBox{flex:0 0 auto;padding-bottom:2px}


    /* COSMIC_TASKS_CALENDAR_SCROLL_WORKSPACE_FIX */
    body[data-tab="Tasks"] main{grid-template-rows:88px minmax(0,1fr) 0 62px}
    body[data-tab="Tasks"] .actions{display:none}
    body[data-tab="Tasks"] .workspace.tasks{height:100%;min-height:0;align-items:stretch;grid-template-columns:minmax(440px,1.16fr) minmax(360px,.84fr)}
    body[data-tab="Tasks"] .workspace.tasks>.card{min-height:0;overflow-y:auto;overscroll-behavior:contain;padding-right:20px}
    body[data-tab="Tasks"] .workspace.tasks .goals{display:block}
    body[data-tab="Tasks"] .workspace.tasks .goalEditor{padding-bottom:10px}
    body[data-tab="Tasks"] .workspace.tasks .scheduleRows{max-height:min(42vh,390px);overflow-y:auto;overscroll-behavior:contain;padding-right:8px}
    body[data-tab="Tasks"] .goalEditor textarea{min-height:104px}
    body[data-tab="Tasks"] .goalObjectiveInputs{max-height:190px;overflow-y:auto;overscroll-behavior:contain;padding-right:6px}
    body[data-tab="Calendar"] .calendarCard{overflow-y:auto;overscroll-behavior:contain}
    body[data-tab="Calendar"] .calendarEditor{overflow-y:auto;overscroll-behavior:contain;padding-right:20px}
    body[data-tab="Calendar"] .eventList{overflow-y:auto;overscroll-behavior:contain}
    body[data-tab="Tasks"] .workspace.tasks>.card,
    body[data-tab="Tasks"] .scheduleRows,
    body[data-tab="Tasks"] .goalObjectiveInputs,
    body[data-tab="Calendar"] .calendarCard,
    body[data-tab="Calendar"] .calendarEditor,
    body[data-tab="Calendar"] .eventList{
      scrollbar-width:thin;
      scrollbar-color:rgba(103,232,249,.78) rgba(15,23,42,.55);
    }
    body[data-tab="Tasks"] .workspace.tasks>.card::-webkit-scrollbar,
    body[data-tab="Tasks"] .scheduleRows::-webkit-scrollbar,
    body[data-tab="Tasks"] .goalObjectiveInputs::-webkit-scrollbar,
    body[data-tab="Calendar"] .calendarCard::-webkit-scrollbar,
    body[data-tab="Calendar"] .calendarEditor::-webkit-scrollbar,
    body[data-tab="Calendar"] .eventList::-webkit-scrollbar{width:10px}
    body[data-tab="Tasks"] .workspace.tasks>.card::-webkit-scrollbar-track,
    body[data-tab="Tasks"] .scheduleRows::-webkit-scrollbar-track,
    body[data-tab="Tasks"] .goalObjectiveInputs::-webkit-scrollbar-track,
    body[data-tab="Calendar"] .calendarCard::-webkit-scrollbar-track,
    body[data-tab="Calendar"] .calendarEditor::-webkit-scrollbar-track,
    body[data-tab="Calendar"] .eventList::-webkit-scrollbar-track{background:rgba(15,23,42,.50);border-radius:999px}
    body[data-tab="Tasks"] .workspace.tasks>.card::-webkit-scrollbar-thumb,
    body[data-tab="Tasks"] .scheduleRows::-webkit-scrollbar-thumb,
    body[data-tab="Tasks"] .goalObjectiveInputs::-webkit-scrollbar-thumb,
    body[data-tab="Calendar"] .calendarCard::-webkit-scrollbar-thumb,
    body[data-tab="Calendar"] .calendarEditor::-webkit-scrollbar-thumb,
