def _ics_escape(value: object) -> str:
    text = str(value or "")
    return text.replace("\\", "\\\\").replace("\n", "\\n").replace(",", "\\,").replace(";", "\\;")


def _ics_unescape(value: str) -> str:
    return (
        value.replace("\\n", "\n")
        .replace("\\,", ",")
        .replace("\\;", ";")
        .replace("\\\\", "\\")
    )


def _ics_datetime(event: dict, key: str = "time") -> str:
    date_part = str(event.get("date") or _today_iso()).replace("-", "")
    time_part = _hhmm(event.get(key))
    if not time_part:
        return f";VALUE=DATE:{date_part}"
    return f":{date_part}T{time_part.replace(':', '')}00"


def _events_to_ics(events: list[dict]) -> str:
    now = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    lines = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//COSMIC//Local Calendar//EN",
        "CALSCALE:GREGORIAN",
        "METHOD:PUBLISH",
    ]
    for event in _sort_events(events):
        uid = f"{event.get('id', uuid.uuid4().hex)}@cosmic.local"
        lines.extend(
            [
                "BEGIN:VEVENT",
                f"UID:{_ics_escape(uid)}",
                f"DTSTAMP:{now}",
                f"DTSTART{_ics_datetime(event, 'time')}",
            ]
        )
        if event.get("end_time"):
            lines.append(f"DTEND{_ics_datetime(event, 'end_time')}")
        lines.append(f"SUMMARY:{_ics_escape(event.get('title'))}")
        if event.get("location"):
            lines.append(f"LOCATION:{_ics_escape(event.get('location'))}")
        if event.get("notes"):
            lines.append(f"DESCRIPTION:{_ics_escape(event.get('notes'))}")
        lines.extend(["END:VEVENT"])
    lines.append("END:VCALENDAR")
    return "\r\n".join(lines) + "\r\n"


def _unfold_ics_lines(text: str) -> list[str]:
    raw_lines = text.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    lines: list[str] = []
    for line in raw_lines:
        if line.startswith((" ", "\t")) and lines:
            lines[-1] += line[1:]
        elif line:
            lines.append(line)
    return lines


def _parse_ics_datetime(value: str) -> tuple[str, str]:
    value = str(value or "").strip()
    if not value:
        return _today_iso(), ""
    if "T" in value:
        date_part, time_part = value.split("T", 1)
        time_part = time_part.replace("Z", "")[:4]
        try:
            date_iso = dt.datetime.strptime(date_part[:8], "%Y%m%d").date().isoformat()
        except ValueError:
            date_iso = _today_iso()
        time_iso = f"{time_part[:2]}:{time_part[2:4]}" if len(time_part) >= 4 else ""
        return date_iso, _hhmm(time_iso)
    try:
        return dt.datetime.strptime(value[:8], "%Y%m%d").date().isoformat(), ""
    except ValueError:
        return _today_iso(), ""


def _parse_ics_events(text: str) -> list[dict]:
    events: list[dict] = []
    current: dict[str, str] | None = None
    for line in _unfold_ics_lines(text):
        upper = line.upper()
        if upper == "BEGIN:VEVENT":
            current = {}
            continue
        if upper == "END:VEVENT" and current is not None:
            start = current.get("DTSTART", "")
            date_iso, time_iso = _parse_ics_datetime(start)
            _, end_iso = _parse_ics_datetime(current.get("DTEND", ""))
            events.append(
                _normalize_event(
                    {
                        "id": current.get("UID") or uuid.uuid4().hex,
                        "title": _ics_unescape(current.get("SUMMARY", "Imported event")),
                        "date": date_iso,
                        "time": time_iso,
                        "end_time": end_iso,
                        "location": _ics_unescape(current.get("LOCATION", "")),
                        "notes": _ics_unescape(current.get("DESCRIPTION", "")),
                        "source": "ics",
                    }
                )
            )
            current = None
            continue
        if current is None or ":" not in line:
            continue
        name, value = line.split(":", 1)
        name = name.split(";", 1)[0].upper()
        if name in {"UID", "SUMMARY", "DTSTART", "DTEND", "DESCRIPTION", "LOCATION"}:
            current[name] = value
    return events


def _upsert_calendar_event(event: dict) -> dict:
    events = _load_calendar_events()
    incoming = _normalize_event(event)
    replaced = False
    for index, existing in enumerate(events):
        if existing.get("id") == incoming["id"]:
            events[index] = incoming
            replaced = True
            break
    if not replaced:
        events.append(incoming)
    _save_calendar_events(events)
    return incoming


def _delete_calendar_event(event_id: str) -> bool:
    event_id = str(event_id or "").strip()
    events = _load_calendar_events()
    kept = [event for event in events if event.get("id") != event_id]
    if len(kept) == len(events):
        return False
    _save_calendar_events(kept)
    return True


def _import_ics_calendar(text: str) -> int:
    imported = _parse_ics_events(text)
    if not imported:
        return 0
    existing = {event.get("id"): event for event in _load_calendar_events()}
    for event in imported:
        if event["id"] in existing:
            event["id"] = f"{event['id']}-{uuid.uuid4().hex[:6]}"
        existing[event["id"]] = event
    _save_calendar_events(list(existing.values()))
    return len(imported)


