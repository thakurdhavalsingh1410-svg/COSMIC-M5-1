    /* COSMIC_EDITABLE_ACTIVE_GOALS */
    .goalEditor{margin-top:14px;display:grid;gap:10px}
    .goalEditor input,.goalEditor textarea{width:100%;border:1px solid rgba(0,240,255,.20);border-radius:13px;background:rgba(2,8,23,.55);color:var(--text);outline:none;padding:10px 12px}
    .goalEditor input{height:39px}
    .goalEditor textarea{min-height:74px;resize:vertical}
    .goalEditor .two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .goalObjectiveInputs{display:grid;gap:8px}
    .goalObjectiveRow{display:grid;grid-template-columns:minmax(0,1fr) 38px;gap:8px}
