def _verify_phone_pin(pin: str, config: dict) -> bool:
    if not config.get("enabled", False):
        return True
    salt = str(config.get("salt", ""))
    expected = str(config.get("pin_hash", ""))
    if not salt or not expected or not pin:
        return False
    actual = hashlib.sha256((salt + str(pin)).encode("utf-8")).hexdigest()
    return actual == expected


