SERVICE_WORKER = r"""// COSMIC_FIX_NEVER_STALE_CACHE
// The cache name is stamped with a per-server-startup token below.
// On activate, every older cache is dropped, so a new COSMIC launch
// can never serve stale JS even if a service worker was previously installed.
const CACHE_NAME = 'cosmic-shell-__COSMIC_BUILD_TOKEN__';
// '/' is intentionally NOT in SHELL. The HTML page must always come from the network
// so fixes like goals/tasks rendering show up immediately on the next refresh.
const SHELL = ['/manifest.webmanifest', '/assets/cosmic_icon.png', '/favicon.ico'];

self.addEventListener('install', event => {
  event.waitUntil(caches.open(CACHE_NAME).then(cache => cache.addAll(SHELL)).catch(() => null));
  self.skipWaiting();
});

self.addEventListener('activate', event => {
  event.waitUntil(
    caches.keys().then(keys => Promise.all(keys.filter(key => key !== CACHE_NAME).map(key => caches.delete(key))))
      .then(() => self.clients.claim())
  );
});

self.addEventListener('fetch', event => {
  const url = new URL(event.request.url);
  // Always bypass cache for the HTML page itself and for any API call.
  // Cached fallback is reserved for static assets only.
  if (url.pathname === '/' || url.pathname.startsWith('/api/')) {
    event.respondWith(fetch(event.request));
    return;
  }
  event.respondWith(
    fetch(event.request).then(response => {
      if (response && response.status === 200 && response.type === 'basic') {
        const clone = response.clone();
        caches.open(CACHE_NAME).then(cache => cache.put(event.request, clone)).catch(() => null);
      }
      return response;
    }).catch(() => caches.match(event.request).then(match => match || Response.error()))
  );
});
"""


