    completed = _goal_int(raw.get("completed", default["completed"]), default["completed"], 0, total)
    objectives_raw = raw.get("objectives", default["objectives"])
    if isinstance(objectives_raw, str):
        objectives = [line.strip() for line in objectives_raw.splitlines() if line.strip()]
    elif isinstance(objectives_raw, list):
        objectives = [_goal_text(item, "", 140) for item in objectives_raw if str(item or "").strip()]
    else:
        objectives = list(default["objectives"])
    objectives = objectives[:12] or list(default["objectives"])
    return {
        "version": 1,
        "title": _goal_text(raw.get("title"), default["title"], 160),
        "completed": completed,
        "total": total,
        "objectives": objectives,
        "recents": _goal_text(raw.get("recents"), default["recents"], 900),
