def _hhmm(value: object) -> str:
    text = str(value or "").strip()
    if not text:
        return ""
    match = re.match(r"^(\d{1,2}):(\d{2})", text)
    if not match:
        return ""
    hour, minute = int(match.group(1)), int(match.group(2))
    if 0 <= hour <= 23 and 0 <= minute <= 59:
        return f"{hour:02d}:{minute:02d}"
    return ""


def _normalize_event(raw: dict, existing_id: str = "") -> dict:
    raw = raw if isinstance(raw, dict) else {}
    event_id = str(raw.get("id") or existing_id or uuid.uuid4().hex).strip()
    event_id = re.sub(r"[^A-Za-z0-9_.:-]", "-", event_id)[:80] or uuid.uuid4().hex
    title = str(raw.get("title") or raw.get("summary") or "Untitled event").strip()[:160]
    date_text = str(raw.get("date") or _today_iso()).strip()[:10]
    try:
        date_text = dt.date.fromisoformat(date_text).isoformat()
    except ValueError:
        date_text = _today_iso()
    return {
        "id": event_id,
        "title": title or "Untitled event",
        "date": date_text,
        "time": _hhmm(raw.get("time")),
        "end_time": _hhmm(raw.get("end_time")),
        "location": str(raw.get("location") or "").strip()[:160],
        "notes": str(raw.get("notes") or raw.get("description") or "").strip()[:1200],
        "source": str(raw.get("source") or "cosmic").strip()[:40] or "cosmic",
        "updated_at": dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat(),
    }


